@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page-scroll-wrapper">

    <div class="honeycomb-bg-wrapper">
        <svg class="honeycomb-bg" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice">
            @foreach (var hex in hexes)
            {
                <polygon class="hex-base" points="@hex.Points"
                         style="animation-delay:@(hex.Delay.ToString("F2"))s; animation-duration:@(hex.Duration.ToString("F2"))s;" />
            }
        </svg>
    </div>

    @inject NavigationManager NavManager

    <MudLayout>

        <MudAppBar Elevation="0"
                   Style="background: linear-gradient(135deg, #052E16, #14532D, #166534); color: white;">

            <MudText Typo="Typo.h6" Class="mr-6">B.Kilby</MudText>

            <MudStack Row="true" Class="nav-desktop" Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Href="home" Color="Color.Inherit">
                    Home
                </MudButton>

                <MudMenu Label="Projects" Color="Color.Inherit" Variant="Variant.Text">
                    <MudMenuItem Href="UnderConstruction">Companies House Data Analyser</MudMenuItem>
                    <MudMenuItem Href="UnderConstruction">Code Retineo</MudMenuItem>
                    <MudMenuItem Href="UnderConstruction">Networked Arena</MudMenuItem>
                    <MudMenuItem Href="UnderConstruction">DLX Snappy</MudMenuItem>
                    <MudMenuItem Href="UnderConstruction">Legal system</MudMenuItem>
                </MudMenu>

                <MudMenu Label="Games" Color="Color.Inherit" Variant="Variant.Text">
                    <MudMenuItem Href="RAPID">RAPID</MudMenuItem>
                    <MudMenuItem Href="CatcherOfTheSnakes">Catcher Of The Snakes</MudMenuItem>
                    <MudMenuItem Href="PandorasPanic">Pandora's Panic</MudMenuItem>
                    <MudMenuItem Href="SKYRAZE">Skyraze</MudMenuItem>
                    <MudMenuItem Href="DrumAndJelly">Drum and Jelly</MudMenuItem>
                </MudMenu>

                <MudMenu Label="Uni projects" Color="Color.Inherit" Variant="Variant.Text">
                    <MudMenuItem Href="MixedRealityProject">Mixed reality</MudMenuItem>
                    <MudMenuItem Href="VRunigame">VR retail game</MudMenuItem>
                    <MudMenuItem Href="UnderConstruction">Open GL environment</MudMenuItem>
                    <MudMenuItem Href="UnderConstruction">Prompt Panic (group work)</MudMenuItem>
                </MudMenu>

                <MudButton Href="about" Color="Color.Inherit">
                    About
                </MudButton>
            </MudStack>

            <MudSpacer />

            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Class="nav-hamburger"
                           OnClick="@(() => _drawerOpen = !_drawerOpen)" />

        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen"
                   Anchor="Anchor.Right"
                   Elevation="1"
                   Variant="DrawerVariant.Temporary"
                   Style="background: linear-gradient(180deg, #052E16, #14532D); color: white;">

            <MudNavMenu Color="Color.Inherit">

                <MudNavLink Href="home" Match="NavLinkMatch.All" OnClick="CloseDrawer">Home</MudNavLink>

                <MudNavGroup Title="Projects" Expanded="false">
                    <MudNavLink Href="UnderConstruction" OnClick="CloseDrawer">Companies House Data Analyser</MudNavLink>
                    <MudNavLink Href="UnderConstruction" OnClick="CloseDrawer">Code Retineo</MudNavLink>
                    <MudNavLink Href="UnderConstruction" OnClick="CloseDrawer">Networked Arena</MudNavLink>
                    <MudNavLink Href="UnderConstruction" OnClick="CloseDrawer">DLX Snappy</MudNavLink>
                    <MudNavLink Href="UnderConstruction" OnClick="CloseDrawer">Legal system</MudNavLink>
                </MudNavGroup>

                <MudNavGroup Title="Games" Expanded="false">
                    <MudNavLink Href="RAPID" OnClick="CloseDrawer">RAPID</MudNavLink>
                    <MudNavLink Href="CatcherOfTheSnakes" OnClick="CloseDrawer">Catcher Of The Snakes</MudNavLink>
                    <MudNavLink Href="PandorasPanic" OnClick="CloseDrawer">Pandora's Panic</MudNavLink>
                    <MudNavLink Href="SKYRAZE" OnClick="CloseDrawer">Skyraze</MudNavLink>
                    <MudNavLink Href="DrumAndJelly" OnClick="CloseDrawer">Drum and Jelly</MudNavLink>
                </MudNavGroup>

                <MudNavGroup Title="Uni projects" Expanded="false">
                    <MudNavLink Href="MixedRealityProject" OnClick="CloseDrawer">Mixed reality project</MudNavLink>
                    <MudNavLink Href="VRunigame" OnClick="CloseDrawer">VR retail game</MudNavLink>
                    <MudNavLink Href="UnderConstruction" OnClick="CloseDrawer">Open GL environment</MudNavLink>
                    <MudNavLink Href="UnderConstruction" OnClick="CloseDrawer">Prompt Panic (group work)</MudNavLink>
                </MudNavGroup>

                <MudNavLink Href="about" Match="NavLinkMatch.All" OnClick="CloseDrawer">About</MudNavLink>

            </MudNavMenu>

        </MudDrawer>

        <MudMainContent>
            @Body
            <Footer />
        </MudMainContent>

    </MudLayout>

    <style>
            .nav-hamburger {
                display: none;
            }

            @@media (max-width: 900px) {
                .nav-desktop {
                    display: none !important;
                }

                .nav-hamburger {
                    display: inline-flex;
                }
            }
    </style>

@code {
    private bool _drawerOpen = false;

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }
}

</div>

<style>
    /* Spans the full page content height (not just the viewport),
           so the absolutely-positioned background below can stretch to match it. */
    .page-scroll-wrapper {
        position: relative;
        min-height: 100vh;
    }

    .honeycomb-bg-wrapper {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background: #0a0b0a;
    }

    .honeycomb-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .hex-base {
        fill: #1c1e1c;
        stroke: #2a2c28;
        stroke-width: 1.5;
        opacity: 0.15;
        animation-name: hexFade;
        animation-iteration-count: infinite;
        animation-timing-function: ease-in-out;
    }

    @@keyframes hexFade {
        0%, 100% {
            opacity: 0.15;
        }

        50% {
            opacity: 0.32;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .hex-base {
            animation: none;
            opacity: 0.18;
        }
    }
</style>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#22C55E",
            Secondary = "#16A34A",
            Background = "#0A0F0D",
            Surface = "#111814",
            TextPrimary = "#F0FDF4",
            TextSecondary = "#A7C4B0"
        }
    };

    private List<HexCell> hexes = new();
    private readonly Random rng = new();

    protected override void OnInitialized() => GenerateGrid();

    private void GenerateGrid()
    {
        const double r = 60;
        const int colStart = -1, cols = 16;
        const int rowStart = -1, rows = 11;
        double hSpacing = r * 1.5;
        double vSpacing = r * Math.Sqrt(3);

        for (int col = colStart; col < cols; col++)
        {
            double x = col * hSpacing;
            double yOffset = col % 2 == 0 ? 0 : vSpacing / 2;
            for (int row = rowStart; row < rows; row++)
            {
                double y = row * vSpacing + yOffset;
                hexes.Add(new HexCell
                {
                    Points = HexPoints(x, y, r),
                    Delay = rng.NextDouble() * 4,
                    Duration = 2.5 + rng.NextDouble() * 3
                });
            }
        }
    }

    private string HexPoints(double cx, double cy, double r)
    {
        var pts = new List<string>();
        for (int i = 0; i < 6; i++)
        {
            double angle = Math.PI / 180 * (60 * i);
            pts.Add($"{(cx + r * Math.Cos(angle)):F1},{(cy + r * Math.Sin(angle)):F1}");
        }
        return string.Join(" ", pts);
    }

    private class HexCell
    {
        public string Points { get; set; } = "";
        public double Delay { get; set; }
        public double Duration { get; set; }
    }
}
