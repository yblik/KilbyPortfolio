@page "/"

@using PortfolioSiteNEW.PortfolioSite
@using PortfolioSiteNEW

<PageTitle>Home</PageTitle>

<HoneycombBackground ProfileImageSrc="images\Profile.jpg">
    <h1>Hi, I'm Ben Kilby 👋</h1>
    <p>Software developer • Solutions Architect • Game developer • Based in Hull </p>
    <p class="quote">"Great software is built one honest problem at a time."</p>

    <div class="cta-row">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/projects"
                   EndIcon="@Icons.Material.Filled.ArrowForward">
            View My CV
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/contact"
                   StartIcon="@Icons.Material.Filled.Mail">
            Get in Touch
        </MudButton>
    </div>
</HoneycombBackground>
@* 
<MudButton Variant="Variant.Filled">Default</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Primary">Primary</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary">Secondary</MudButton>
<MudButton Variant="Variant.Filled" Disabled="true">Disabled</MudButton> *@
<MudDivider />



<MudDivider />

<!-- About Preview -->
<!-- About Preview -->
<MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h4" Class="mb-4">Experience</MudText>
            <MudTimeline TimelinePosition="TimelinePosition.Start">
                @foreach (var exp in _experience)
                {
                    <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                        <ItemContent>
                            <MudText Typo="Typo.subtitle1" Class="font-bold">@exp.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@exp.Company · @exp.Period</MudText>
                            <MudText Typo="Typo.body2" Class="mt-1">@exp.Description[0]</MudText>
                            @if (exp.Description.Count > 1)
                            {
                                <MudList T="string" Dense="true" Class="mt-1">
                                    @foreach (var point in exp.Description.Skip(1))
                                    {
                                        <MudListItem Icon="@Icons.Material.Outlined.Circle" IconSize="Size.Small">
                                            @point
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
            <MudButton Href="/about" Class="mt-4" EndIcon="@Icons.Material.Filled.ArrowForward">
                More About Me
            </MudButton>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudGrid>
                @foreach (var stat in _stats)
                {
                    <MudItem xs="6">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudIcon Icon="@stat.Icon" Color="Color.Primary" Class="mb-2" />
                            <MudText Typo="Typo.h5">@stat.Value</MudText>
                            <MudText Typo="Typo.caption">@stat.Label</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>

<MudDivider />

@code {

    public static List<string> uniExperience = new()
    {
        "Practical development across AI, game dev, graphics programming, VR/MR, and team-based projects.",
        "Game Jams (always top 3). Once led a team of 2 and delivered complete prototypes under time pressure.",
        "VR & MR Retail Systems. Built immersive retail simulations in Unity VR and Mixed Reality with custom interaction systems.",
        "AI Chatbot Narrative Game (Agile, team of 3). Developed dialogue logic and sprint-based features for a game where players impersonate an AI.",
        "OpenGL 3D Environment. Implemented matrices, indices, buffers, and scenegraphs for a custom rendering pipeline.",
        "AI Module. Built and compared neural networks, A*, BFS/DFS, and non-linear regression for ML tasks."
    };

    private List<ExperienceItem> _experience = new()
    {
        new ExperienceItem { Title = "Feedback engineer", Company = "University of Hull", Period = "2025 – 2026", Description = new List<string> { "Marked students coding solutions and helped them with issues." } },
        new ExperienceItem { Title = "Solutions architect", Company = "Flexworks", Period = "2025 – Present", Description = new List<string> { "Building tools spanning Companies data processing and intelligence, Python, OCR, APIs, web scraping." } },
        new ExperienceItem { Title = "Computer science student", Company = "University of Hull", Period = "2024 - 2027", Description = uniExperience },
        new ExperienceItem { Title = "IT student", Company = "Wilberforce College", Period = "2022 - 2024", Description = new List<string> { "Built data-driven applications using MS Access, performed cybersecurity investigations, and delivered IT support solutions as part of coursework." } },
        new ExperienceItem { Title = "Game developer", Company = "DLX INTERACTIVE", Period = "2019 - 2022", Description = new List<string> { "Studying software engineering, algorithms, databases and advanced programming concepts." } },
        // add more entries here
    };

    public class ExperienceItem
    {
        public string? Title { get; set; }
        public string? Company { get; set; }
        public string? Period { get; set; }
        public List<string> Description { get; set; } = new();
    }
}

<!-- Projects Preview -->
<MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
    <MudText Typo="Typo.h4" Class="mb-2">Featured Projects</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        A few things I've been building. Placeholder descriptions — swap in real project details.
    </MudText>
    <MudGrid>
        @foreach (var project in ProjectData.Projects)
        {
            <MudItem xs="12" sm="6" md="4">
                <ProjectCard Project="project" />
            </MudItem>
        }
    </MudGrid>
</MudContainer>

<MudDivider />

<!-- Contact CTA -->
<MudContainer MaxWidth="MaxWidth.Large" Class="py-12 text-center">
    <MudText Typo="Typo.h4" Class="mb-4">Let's Work Together</MudText>
    <MudText Typo="Typo.body1" Class="mb-6">
        Placeholder call-to-action text. Have a project in mind or just want to chat? Reach out.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/contact"
               StartIcon="@Icons.Material.Filled.Mail">
        Contact Me
    </MudButton>
</MudContainer>

@code {
    private record Stat(string Icon, string Value, string Label);

    private readonly List<Stat> _stats = new()
    {
        new(Icons.Material.Filled.Code, "10+", "Projects Built"),
        new(Icons.Material.Filled.Devices, "3", "Core Platforms"),
        new(Icons.Material.Filled.Timeline, "5+", "Years Coding"),
        new(Icons.Material.Filled.EmojiObjects, "∞", "Ideas Brewing")
    };
}
