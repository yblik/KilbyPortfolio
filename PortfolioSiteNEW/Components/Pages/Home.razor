<!-- About Preview -->
<!-- About Preview -->
<MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h4" Class="mb-4">Experience</MudText>
            <MudTimeline TimelinePosition="TimelinePosition.Start">
                @foreach (var exp in _experience)
                {
                    <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                        <ItemContent>
                            <MudText Typo="Typo.subtitle1" Class="font-bold">@exp.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@exp.Company · @exp.Period</MudText>
                            <MudText Typo="Typo.body2" Class="mt-1">@exp.Description[0]</MudText>
                            @if (exp.Description.Count > 1)
                            {
                                <MudList T="string" Dense="true" Class="mt-1">
                                    @foreach (var point in exp.Description.Skip(1))
                                    {
                                        <MudListItem Icon="@Icons.Material.Outlined.Circle" IconSize="Size.Small">
                                            @point
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
            <MudButton Href="/about" Class="mt-4" EndIcon="@Icons.Material.Filled.ArrowForward">
                More About Me
            </MudButton>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudGrid>
                @foreach (var stat in _stats)
                {
                    <MudItem xs="6">
                        <MudPaper Class="pa-4 text-center" Elevation="1">
                            <MudIcon Icon="@stat.Icon" Color="Color.Primary" Class="mb-2" />
                            <MudText Typo="Typo.h5">@stat.Value</MudText>
                            <MudText Typo="Typo.caption">@stat.Label</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Tech Stack</MudText>
                <MudGrid>
                    @foreach (var tech in _techStack)
                    {
                        <MudItem xs="3">
                            <MudPaper Class="pa-3 text-center" Elevation="0" Style="background-color: transparent;">
                                @if (tech.IconUrl is not null)
                                {
                                    <img src="@tech.IconUrl" alt="@tech.Name" style="width: 32px; height: 32px;" />
                                }
                                else
                                {
                                    <MudIcon Icon="@tech.MudIcon" Color="Color.Primary" Style="font-size: 32px;" />
                                }
                                <MudText Typo="Typo.caption" Class="mt-1" Style="display: block;">@tech.Name</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
            <MudContainer MaxWidth="MaxWidth.Large" Class="pb-12">
                <MudText Typo="Typo.h4" Class="mb-4">Education & Grades</MudText>
                <MudGrid>
                    @foreach (var edu in _education)
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4" Elevation="1">
                                <MudText Typo="Typo.subtitle1" Class="font-bold">@edu.Stage</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@edu.Institution · @edu.Period</MudText>
                                @if (edu.Grade is not null)
                                {
                                    <MudText Typo="Typo.body1" Class="mb-2">@edu.Grade</MudText>
                                }
                                @if (edu.Modules.Count > 0)
                                {
                                    <MudList T="string" Dense="true">
                                        @foreach (var module in edu.Modules)
                                        {
                                            <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success" IconSize="Size.Small">
                                                @module
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudContainer>
        </MudItem>
    </MudGrid>
</MudContainer>

<MudDivider />

